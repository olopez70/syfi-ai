#!/usr/bin/env python3
"""
SyFi AI - Synthetic Banking Data Library
Main CLI interface and demonstration script.
"""

import sys
import json
from pathlib import Path

# Add src to path for imports
sys.path.insert(0, str(Path(__file__).parent / 'src'))

from syfi import SyFiGenerator
from syfi.core.parser import ConfigurationParser

def demo_natural_language_parsing():
    """Demonstrate natural language parsing capabilities."""
    print("🏦 SyFi AI - Synthetic Banking Data Library")
    print("=" * 50)
    
    # Example natural language prompts
    prompts = [
        "Generate monthly salary deposits of $3,500 on the 15th",
        "Create weekly grocery spending between $80-120 on weekends", 
        "Simulate quarterly tax payments of 22% of income",
        "Generate random ATM withdrawals of $20-200, 2-5 times per week"
    ]
    
    parser = ConfigurationParser()
    
    for i, prompt in enumerate(prompts, 1):
        print(f"\n{i}. Processing: '{prompt}'")
        print("-" * 40)
        
        try:
            config = parser.parse(prompt)
            print("✅ Parsed successfully!")
            print(f"   - Transaction Type: {config.get('transaction_type', 'N/A')}")
            print(f"   - Category: {config.get('category', 'N/A')}")
            print(f"   - Amount Type: {config.get('amount_type', 'N/A')}")
            print(f"   - Amount Value: ${config.get('amount', 0)}")
            print(f"   - Frequency: {config.get('frequency', 'N/A')}")
            
            # Save example config
            config_file = f"example_config_{i}.json"
            with open(config_file, 'w') as f:
                json.dump(config, f, indent=2)
            print(f"   - Saved to: {config_file}")
            
        except Exception as e:
            print(f"❌ Parsing failed: {e}")

def demo_realistic_banking_data():
    """Demonstrate realistic banking data generation."""
    print("\n\n🎯 Realistic Banking Data Generation Demo")
    print("=" * 45)
    
    # Import the working banking data generation classes
    from syfi.profile_builder import ProfileBuilder, BankingDataGenerator, create_young_professional_template
    from syfi.database import DatabaseManager
    from datetime import date
    
    # Setup database
    db_path = "data/main_demo.db"
    db_manager = DatabaseManager(db_path)
    db_manager.initialize_schema()
    
    print("📁 Database initialized")
    
    try:
        # Create a profile template
        template = create_young_professional_template()
        print(f"✅ Profile template created: {template.name}")
        
        # Create profile builder and generate a family profile
        builder = ProfileBuilder(db_manager)
        profile = builder.build_profile(template)
        print(f"✅ Generated profile: {profile.profile_name}")
        print(f"   Household Income: ${profile.household_income:,}")
        
        # Generate banking data for January 2025  
        generator = BankingDataGenerator(db_manager)
        results = generator.generate_banking_data(
            profile_id=profile.profile_id,
            start_date=date(2025, 1, 1),
            end_date=date(2025, 1, 31)
        )
        
        print(f"✅ Generated banking data for January 2025:")
        print(f"   Customers: {results['customers_created']}")
        print(f"   Accounts: {results['accounts_created']}")
        print(f"   Transactions: {results['transactions_created']}")
        print(f"   Total Volume: ${results['total_transaction_volume']:,.2f}")
        
        # Show sample transactions
        recent_transactions = db_manager.get_recent_transactions(5)
        if recent_transactions:
            print(f"\n📊 Sample Transactions:")
            for txn in recent_transactions:
                amount_str = f"+${txn.amount:.2f}" if txn.amount > 0 else f"-${abs(txn.amount):.2f}"
                print(f"   {txn.transaction_date} | {amount_str:>10} | {txn.description}")
        
    except Exception as e:
        print(f"❌ Error generating banking data: {e}")
    finally:
        db_manager.close()
        print("💾 Database closed") CLI interface and demonstration script.
"""

import sys
import json
from pathlib import Path

# Add src to path for imports
sys.path.insert(0, str(Path(__file__).parent / 'src'))

from syfi import SyFiGenerator
from syfi.core.parser import ConfigurationParser

def demo_natural_language_parsing():
    """Demonstrate natural language parsing capabilities."""
    print("🏦 SyFi AI - Synthetic Banking Data Library")
    print("=" * 50)
    
    # Example natural language prompts
    prompts = [
        "Generate monthly salary deposits of $3,500 on the 15th",
        "Create weekly grocery spending between $80-120 on weekends", 
        "Simulate quarterly tax payments of 22% of income",
        "Generate random ATM withdrawals of $20-200, 2-5 times per week"
    ]
    
    parser = ConfigurationParser()
    
    for i, prompt in enumerate(prompts, 1):
        print(f"\n{i}. Processing: '{prompt}'")
        print("-" * 40)
        
        try:
            # Parse natural language to configuration
            config = parser.parse(prompt)
            
            print(f"✅ Parsed successfully!")
            print(f"   - Transaction Type: {config.transaction_patterns[0].type}")
            print(f"   - Category: {config.transaction_patterns[0].category}")
            print(f"   - Amount Type: {config.transaction_patterns[0].amount.type}")
            if config.transaction_patterns[0].amount.value:
                print(f"   - Amount Value: ${config.transaction_patterns[0].amount.value}")
            if config.transaction_patterns[0].amount.min and config.transaction_patterns[0].amount.max:
                print(f"   - Amount Range: ${config.transaction_patterns[0].amount.min} - ${config.transaction_patterns[0].amount.max}")
            print(f"   - Frequency: {config.transaction_patterns[0].schedule.frequency}")
            
            # Save configuration example
            config_file = f"example_config_{i}.json"
            config.save_to_file(config_file)
            print(f"   - Saved to: {config_file}")
            
        except Exception as e:
            print(f"❌ Error: {e}")

def demo_syfi_generator():
    """Demonstrate SyFi generator usage."""
    print("\n\n🎯 SyFi Generator Demo")
    print("=" * 30)
    
    # Create generator from natural language
    generator = SyFiGenerator()
    generator.from_natural_language("Generate weekly grocery spending between $50-100 on weekends")
    
    print("✅ Generator created from natural language")
    print("📊 Generating transactions for Q1 2024...")
    
    # Generate transactions (placeholder for now)
    transactions = generator.generate_period("2024-01-01", "2024-03-31")
    print(f"Generated {len(transactions)} transactions")

def show_project_info():
    """Show project information and capabilities."""
    print("\n\n📋 Project Information")
    print("=" * 25)
    
    info = {
        "Library": "SyFi AI",
        "Version": "0.1.0", 
        "Purpose": "Synthetic Banking Data Generation",
        "Features": [
            "Natural language to configuration parsing",
            "Deterministic transaction generation",
            "Banking domain data models",
            "Extensible plugin architecture",
            "Multiple export formats (JSON, CSV, Excel)"
        ]
    }
    
    for key, value in info.items():
        if isinstance(value, list):
            print(f"{key}:")
            for item in value:
                print(f"  • {item}")
        else:
            print(f"{key}: {value}")

def main():
    """Main function - entry point of the application."""
    try:
        # Run demonstrations
        demo_natural_language_parsing()
        demo_realistic_banking_data()
        show_project_info()
        
        print("\n\n🚀 Next Steps:")
        print("1. Extend transaction generation logic")
        print("2. Add more natural language patterns")
        print("3. Implement plugin system")
        print("4. Add comprehensive test suite")
        print("\nFor more information, see README.md and docs/")
        
    except KeyboardInterrupt:
        print("\n\n👋 Goodbye!")
    except Exception as e:
        print(f"\n❌ Error: {e}")
        return 1
    
    return 0

if __name__ == "__main__":
    sys.exit(main())